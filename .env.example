# 智能日报生成器 - 环境变量模板（v1.15）
# 使用方法：复制本文件为 .env，填入真实值。
# .env 已在 .gitignore 中，不会被提交；仓库只保留本模板。
#
# 加载规则：系统环境变量 > .env > 代码默认值（已存在的变量不会被 .env 覆盖）

# ---- 飞书自建应用 ----
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 飞书机器人（群推送）----
LARK_BOT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# ---- 邮件（QQ 邮箱 SMTP）----
SMTP_USER=you@qq.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM=you@qq.com

# ---- GitHub 采集 ----
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# ---- 可选：自签证书（如 Watt Toolkit）----
# SSL_CERT_FILE=C:\path\to\combined-ca.pem
